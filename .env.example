PORT=3001
HOST=127.0.0.1
AGENT_DATA_FILE=server/data/runtime-store.json
DEFAULT_TENANT_ID=andina
AGENT_TIMEZONE=America/Bogota

# WhatsApp Cloud API verification and optional live sender.
# Leave WHATSAPP_PROVIDER_MODE=mock until real Meta credentials are configured.
WHATSAPP_PROVIDER_MODE=mock
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=

# Google and write integrations are represented as tenant-scoped secret references
# in the backend store. Do not put plain tenant secrets in UI payloads.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN_REF=
GOOGLE_ALLOWED_SCOPES=
WORKSPACE_WRITE_API_KEY=
