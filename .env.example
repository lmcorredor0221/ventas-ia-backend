# Core runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
PUBLIC_APP_URL=http://127.0.0.1:3001
# URL publica del frontend. En produccion suele ser distinta de la API.
FRONTEND_APP_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Storage
STORAGE_DRIVER=json
AGENT_DATA_FILE=server/data/runtime-store.json
ALLOW_LOCAL_CATALOG_FALLBACK=true
INTEGRATION_OUTBOX_ENABLED=false
INTEGRATION_OUTBOX_INTERVAL_MS=5000
INTEGRATION_OUTBOX_BATCH_SIZE=10
DATABASE_URL=postgres://usrventas:usrventas@127.0.0.1:5432/ventas_ia_dev
DATABASE_SSL=disable

# Auth and session hardening
AUTH_REQUIRED=false
CSRF_REQUIRED=false
ALLOW_DEV_GOOGLE_LOGIN=true
SESSION_COOKIE_NAME=ventas_ia_session
SESSION_TTL_HOURS=168
# Correos con acceso al Centro de control de la plataforma (separados por coma)
PLATFORM_ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# LLM
LLM_REQUEST_TIMEOUT_MS=15000
LLM_MAX_TOKENS=1200
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# WhatsApp Cloud API
WHATSAPP_PROVIDER_MODE=mock
WHATSAPP_GRAPH_API_VERSION=v26.0
# URL HTTPS recibida por Meta. Si se omite, usa PUBLIC_APP_URL/webhooks/whatsapp.
WHATSAPP_WEBHOOK_PUBLIC_URL=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# Habilitar solo tras aprobar Meta el acceso avanzado para incorporar negocios de clientes.
META_WHATSAPP_ADVANCED_ACCESS_APPROVED=false
# Estado informativo: not_submitted, in_review o changes_requested. No habilita el registro.
META_WHATSAPP_APP_REVIEW_STATUS=not_submitted
WHATSAPP_EMBEDDED_SIGNUP_REDIRECT_URI=
WHATSAPP_TENANT_TOKEN_LIFETIME_DAYS=60
WHATSAPP_TENANT_TOKEN_RENEWAL_WINDOW_DAYS=14
# Optional and restricted to one platform-admin pilot tenant. This lets the
# platform demonstrate its own Meta test number while Advanced Access is pending.
# Never point these values at a customer tenant or a customer WhatsApp number.
META_WHATSAPP_TEST_CHANNEL_ENABLED=false
META_WHATSAPP_TEST_TENANT_ID=
META_WHATSAPP_TEST_PHONE_NUMBER_ID=
META_WHATSAPP_TEST_WABA_ID=
META_WHATSAPP_TEST_ACCESS_TOKEN=
META_WHATSAPP_TEST_DISPLAY_PHONE_NUMBER=
META_WHATSAPP_TEST_VERIFIED_NAME=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PREAPPROVAL_PLAN_ID=
MERCADOPAGO_WEBHOOK_SECRET=

# Google Drive/Sheets OAuth
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/saas/google/oauth/callback
# Optional only for local billing contract tests. Leave false or omit in production.
ALLOW_MOCK_BILLING_ACTIVATION=true
SECRET_ENCRYPTION_KEY=
