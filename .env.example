# Core runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
PUBLIC_APP_URL=http://127.0.0.1:3001
# URL publica del frontend. En produccion suele ser distinta de la API.
FRONTEND_APP_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Storage
STORAGE_DRIVER=json
AGENT_DATA_FILE=server/data/runtime-store.json
ALLOW_LOCAL_CATALOG_FALLBACK=true
INTEGRATION_OUTBOX_ENABLED=false
INTEGRATION_OUTBOX_INTERVAL_MS=5000
INTEGRATION_OUTBOX_BATCH_SIZE=10
# En produccion: true en el worker y false en el servicio HTTP.
BACKGROUND_WORKERS_ENABLED=true
# Activalo junto con INTEGRATION_OUTBOX_ENABLED cuando el worker del piloto este listo.
WHATSAPP_ASYNC_INBOUND_ENABLED=false
# Incluye mensajes entrantes, proyecciones de Sheets y otros efectos externos.
INTEGRATION_OUTBOX_MAX_ATTEMPTS=8
DATABASE_URL=postgres://usrventas:usrventas@127.0.0.1:5432/ventas_ia_dev
DATABASE_SSL=disable

# Auth and session hardening
AUTH_REQUIRED=false
CSRF_REQUIRED=false
ALLOW_DEV_GOOGLE_LOGIN=true
SESSION_COOKIE_NAME=ventas_ia_session
SESSION_TTL_HOURS=168
# Correos con acceso al Centro de control de la plataforma (separados por coma)
PLATFORM_ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# LLM
LLM_REQUEST_TIMEOUT_MS=15000
LLM_MAX_TOKENS=1200
# Conserva el fallback transaccional si se desactiva temporalmente el redactor LLM.
LLM_RESPONSE_COMPOSER_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# WhatsApp Cloud API
WHATSAPP_PROVIDER_MODE=mock
WHATSAPP_GRAPH_API_VERSION=v21.0
# URL HTTPS recibida por Meta. Si se omite, usa PUBLIC_APP_URL/webhooks/whatsapp.
WHATSAPP_WEBHOOK_PUBLIC_URL=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_EMBEDDED_SIGNUP_REDIRECT_URI=
# Cambiar a true solo cuando Meta apruebe whatsapp_business_management y whatsapp_business_messaging.
META_WHATSAPP_ADVANCED_ACCESS_APPROVED=false
# Estado informativo: not_submitted, in_review o changes_requested. No habilita el registro.
META_WHATSAPP_APP_REVIEW_STATUS=not_submitted

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PREAPPROVAL_PLAN_ID=
MERCADOPAGO_WEBHOOK_SECRET=

# Google Drive/Sheets OAuth
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/saas/google/oauth/callback
# Optional only for local billing contract tests. Keep false or omit in production.
ALLOW_MOCK_BILLING_ACTIVATION=true
SECRET_ENCRYPTION_KEY=
