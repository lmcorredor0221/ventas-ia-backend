# Copy this file to .env.e2e.local and set the two real local credentials.
# This test only reads ventas_ia_dev. It clones it into ventas_ia_e2e_<runId>.
NODE_ENV=test
HOST=127.0.0.1
AUTH_REQUIRED=false
CSRF_REQUIRED=false
STORAGE_DRIVER=postgres
DATABASE_SSL=disable
E2E_SOURCE_DATABASE_URL=postgres://<user>:<password>@127.0.0.1:5432/ventas_ia_dev
E2E_BASELINE_TENANT_ID=andina
# Fixture de referencia solo dentro del tenant sombra del clon; nunca carga una tienda real.
E2E_CATALOG_REFERENCE_FIXTURE=colombia300

# Required: the E2E harness uses the live DeepSeek integration.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_REQUEST_TIMEOUT_MS=30000
LLM_MAX_TOKENS=1200
LLM_RESPONSE_COMPOSER_ENABLED=true

# Meta is simulated locally, but Graph payloads use live-provider contracts.
WHATSAPP_PROVIDER_MODE=live
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_APP_SECRET=e2e-webhook-secret-only
WHATSAPP_WEBHOOK_VERIFY_TOKEN=e2e-verify-token-only
WHATSAPP_ASYNC_INBOUND_ENABLED=true
INTEGRATION_OUTBOX_ENABLED=true
BACKGROUND_WORKERS_ENABLED=false
ALLOW_LOCAL_CATALOG_FALLBACK=true

# Safety, duration, and evidence controls.
E2E_MAX_DEEPSEEK_CALLS=160
E2E_MAX_CASE_DURATION_MS=90000
E2E_RESULT_DIR=test-results/e2e-local
E2E_KEEP_CLONE=true
E2E_DROP_CLONE=false
# Optional. If empty, the script locates the newest local PostgreSQL bin folder.
PG_BIN=
